# Notion internal-integration token (notion.so → Settings → Integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Channel chat ID — for channels this is a negative number starting with -100
# Get it by running: python scripts/get_chat_id.py
TELEGRAM_CHAT_ID=-1001234567890

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional — override the default timezone (Europe/Dublin)
TZ=Europe/Dublin
